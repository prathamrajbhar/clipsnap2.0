#!/bin/sh
set -e

# Stop running user services on removal and remove user shortcuts
for u in $(who | awk '{print $1}' | sort -u); do
    uid=$(id -u "$u" 2>/dev/null || true)
    if [ -n "$uid" ] && [ "$uid" -ge 1000 ]; then
        if [ -x /usr/bin/clipsnap ]; then
            su - "$u" -c "DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus /usr/bin/clipsnap --uninstall" 2>/dev/null || true
        fi
        su - "$u" -c "XDG_RUNTIME_DIR=/run/user/$uid systemctl --user stop clipsnap.service" 2>/dev/null || true
        su - "$u" -c "XDG_RUNTIME_DIR=/run/user/$uid systemctl --user disable clipsnap.service" 2>/dev/null || true
    fi
done

rm -f /usr/lib/systemd/user/graphical-session.target.wants/clipsnap.service || true

exit 0
